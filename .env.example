# EARLY-TRACE - local environment template
# Copy this file to .env and fill values only when the corresponding G1 access
# and source-contract checks have been completed.
# Never commit .env or place wallet/private signing keys here.

EARLY_TRACE_ENV=development
EARLY_TRACE_LOG_LEVEL=INFO

# Ethereum JSON-RPC endpoint.
# Use a READ-ONLY endpoint. Keep any provider token embedded in this URL private.
# Leave empty while the RPC provider and access conditions remain unverified.
ETHEREUM_RPC_URL=

# External report source (generic by design; provider/source is not yet frozen).
# Populate only after G1 verifies access, license, retention, coverage, pagination,
# quota, and the timestamp/absence semantics required by the protocol.
REPORT_SOURCE_BASE_URL=
REPORT_SOURCE_API_KEY=

# If Chainabuse is later selected and its actual access contract is verified,
# put its credential here instead of committing it to source code:
# CHAINABUSE_API_KEY=
